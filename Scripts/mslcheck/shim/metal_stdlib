inline float4 mix(float4 a, float4 b, float4 t) { return a + (b - a) * t; }

inline float step(float e, float x) { return x < e ? 0.f : 1.f; }
inline float2 step(float2 e, float2 x) { return float2{step(e.x, x.x), step(e.y, x.y)}; }
inline float3 step(float3 e, float3 x) { return float3{step(e.x, x.x), step(e.y, x.y), step(e.z, x.z)}; }
inline float4 step(float4 e, float4 x) { return float4{step(e.x, x.x), step(e.y, x.y), step(e.z, x.z), step(e.w, x.w)}; }
inline float2 step(float e, float2 x) { return step(float2{e, e}, x); }
inline float3 step(float e, float3 x) { return step(float3{e, e, e}, x); }
inline float4 step(float e, float4 x) { return step(float4{e, e, e, e}, x); }

inline float smoothstep(float a, float b, float x) { float t = isd_sat((x - a) / (b - a)); return t * t * (3.f - 2.f * t); }
inline float2 smoothstep(float2 a, float2 b, float2 x) { return float2{smoothstep(a.x, b.x, x.x), smoothstep(a.y, b.y, x.y)}; }
inline float3 smoothstep(float3 a, float3 b, float3 x) { return float3{smoothstep(a.x, b.x, x.x), smoothstep(a.y, b.y, x.y), smoothstep(a.z, b.z, x.z)}; }
inline float4 smoothstep(float4 a, float4 b, float4 x) { return float4{smoothstep(a.x, b.x, x.x), smoothstep(a.y, b.y, x.y), smoothstep(a.z, b.z, x.z), smoothstep(a.w, b.w, x.w)}; }
inline float2 smoothstep(float a, float b, float2 x) { return smoothstep(float2{a, a}, float2{b, b}, x); }
inline float3 smoothstep(float a, float b, float3 x) { return smoothstep(float3{a, a, a}, float3{b, b, b}, x); }
inline float4 smoothstep(float a, float b, float4 x) { return smoothstep(float4{a, a, a, a}, float4{b, b, b, b}, x); }

inline float dot(float2 a, float2 b) { return a.x * b.x + a.y * b.y; }
inline float dot(float3 a, float3 b) { return a.x * b.x + a.y * b.y + a.z * b.z; }
inline float dot(float4 a, float4 b) { return a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w; }
inline float length(float x) { return __builtin_fabsf(x); }
inline float length(float2 v) { return __builtin_sqrtf(dot(v, v)); }
inline float length(float3 v) { return __builtin_sqrtf(dot(v, v)); }
inline float length(float4 v) { return __builtin_sqrtf(dot(v, v)); }
inline float length_squared(float2 v) { return dot(v, v); }
inline float length_squared(float3 v) { return dot(v, v); }
inline float distance(float2 a, float2 b) { return length(a - b); }
inline float distance(float3 a, float3 b) { return length(a - b); }
inline float2 normalize(float2 v) { return v / length(v); }
inline float3 normalize(float3 v) { return v / length(v); }
inline float4 normalize(float4 v) { return v / length(v); }
inline float3 cross(float3 a, float3 b) { return float3{a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x}; }
inline float2 reflect(float2 i, float2 n) { return i - 2.f * dot(n, i) * n; }
inline float3 reflect(float3 i, float3 n) { return i - 2.f * dot(n, i) * n; }
inline float fma(float a, float b, float c) { return a * b + c; }

template <class T> inline T select(T a, T b, bool c) { return c ? b : a; }
inline bool any(bool b) { return b; }

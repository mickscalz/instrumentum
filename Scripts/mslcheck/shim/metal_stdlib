// ---- matrices (column-major, as in Metal)
struct float2x2 {
    float2 c[2];
    float2x2() : c{float2{0, 0}, float2{0, 0}} {}
    explicit float2x2(float d) : c{float2{d, 0}, float2{0, d}} {}
    float2x2(float2 a, float2 b) : c{a, b} {}
    float2x2(float a, float b, float d, float e) : c{float2{a, b}, float2{d, e}} {}
    float2 &operator[](int i) { return c[i]; }
    float2 operator[](int i) const { return c[i]; }
};
struct float3x3 {
    float3 c[3];
    float3x3() : c{float3{0, 0, 0}, float3{0, 0, 0}, float3{0, 0, 0}} {}
    explicit float3x3(float d) : c{float3{d, 0, 0}, float3{0, d, 0}, float3{0, 0, d}} {}
    float3x3(float3 a, float3 b, float3 d) : c{a, b, d} {}
    float3 &operator[](int i) { return c[i]; }
    float3 operator[](int i) const { return c[i]; }
};
struct float4x4 {
    float4 c[4];
    float4x4() : c{float4{0, 0, 0, 0}, float4{0, 0, 0, 0}, float4{0, 0, 0, 0}, float4{0, 0, 0, 0}} {}
    float4x4(float4 a, float4 b, float4 d, float4 e) : c{a, b, d, e} {}
    float4 &operator[](int i) { return c[i]; }
    float4 operator[](int i) const { return c[i]; }
};
inline float2 operator*(const float2x2 &m, float2 v) { return m.c[0] * v.x + m.c[1] * v.y; }
inline float3 operator*(const float3x3 &m, float3 v) { return m.c[0] * v.x + m.c[1] * v.y + m.c[2] * v.z; }
inline float4 operator*(const float4x4 &m, float4 v) { return m.c[0] * v.x + m.c[1] * v.y + m.c[2] * v.z + m.c[3] * v.w; }
inline float2 operator*(float2 v, const float2x2 &m) { return float2{v.x * m.c[0].x + v.y * m.c[0].y, v.x * m.c[1].x + v.y * m.c[1].y}; }
inline float3 isd_dot3(float3 a, float3 b) { return a.x * b.x + a.y * b.y + a.z * b.z; }
inline float3 operator*(float3 v, const float3x3 &m) { return float3{isd_dot3(v, m.c[0]).x, isd_dot3(v, m.c[1]).x, isd_dot3(v, m.c[2]).x}; }
inline float2x2 operator*(const float2x2 &a, const float2x2 &b) { return float2x2(a * b.c[0], a * b.c[1]); }
inline float3x3 operator*(const float3x3 &a, const float3x3 &b) { return float3x3(a * b.c[0], a * b.c[1], a * b.c[2]); }
inline float3x3 transpose(const float3x3 &m) {
    return float3x3(float3{m.c[0].x, m.c[1].x, m.c[2].x}, float3{m.c[0].y, m.c[1].y, m.c[2].y}, float3{m.c[0].z, m.c[1].z, m.c[2].z});
}

// ---- element-wise maths
#define ISD_UN(NAME, IMPL)                                                                                     \
    inline float NAME(float x) { return IMPL(x); }                                                             \
    inline float2 NAME(float2 v) { return float2{IMPL(v.x), IMPL(v.y)}; }                                      \
    inline float3 NAME(float3 v) { return float3{IMPL(v.x), IMPL(v.y), IMPL(v.z)}; }                           \
    inline float4 NAME(float4 v) { return float4{IMPL(v.x), IMPL(v.y), IMPL(v.z), IMPL(v.w)}; }
#define ISD_BIN(NAME, IMPL)                                                                                    \
    inline float NAME(float a, float b) { return IMPL(a, b); }                                                 \
    inline float2 NAME(float2 a, float2 b) { return float2{IMPL(a.x, b.x), IMPL(a.y, b.y)}; }                  \
    inline float3 NAME(float3 a, float3 b) { return float3{IMPL(a.x, b.x), IMPL(a.y, b.y), IMPL(a.z, b.z)}; }   \
    inline float4 NAME(float4 a, float4 b) { return float4{IMPL(a.x, b.x), IMPL(a.y, b.y), IMPL(a.z, b.z), IMPL(a.w, b.w)}; } \
    inline float2 NAME(float2 a, float b) { return NAME(a, float2{b, b}); }                                    \
    inline float3 NAME(float3 a, float b) { return NAME(a, float3{b, b, b}); }                                 \
    inline float4 NAME(float4 a, float b) { return NAME(a, float4{b, b, b, b}); }

inline float isd_fract(float x) { return x - __builtin_floorf(x); }
inline float isd_sat(float x) { return x < 0 ? 0.f : (x > 1 ? 1.f : x); }
inline float isd_sign(float x) { return x > 0 ? 1.f : (x < 0 ? -1.f : 0.f); }
inline float isd_rsqrt(float x) { return 1.f / __builtin_sqrtf(x); }
ISD_UN(abs, __builtin_fabsf) ISD_UN(fabs, __builtin_fabsf) ISD_UN(floor, __builtin_floorf) ISD_UN(ceil, __builtin_ceilf)
ISD_UN(round, __builtin_roundf) ISD_UN(rint, __builtin_rintf) ISD_UN(trunc, __builtin_truncf) ISD_UN(fract, isd_fract)
ISD_UN(sqrt, __builtin_sqrtf) ISD_UN(rsqrt, isd_rsqrt) ISD_UN(exp, __builtin_expf) ISD_UN(exp2, __builtin_exp2f)
ISD_UN(log, __builtin_logf) ISD_UN(log2, __builtin_log2f) ISD_UN(log10, __builtin_log10f) ISD_UN(sin, __builtin_sinf)
ISD_UN(cos, __builtin_cosf) ISD_UN(tan, __builtin_tanf) ISD_UN(asin, __builtin_asinf) ISD_UN(acos, __builtin_acosf)
ISD_UN(atan, __builtin_atanf) ISD_UN(sinh, __builtin_sinhf) ISD_UN(cosh, __builtin_coshf) ISD_UN(tanh, __builtin_tanhf)
ISD_UN(saturate, isd_sat) ISD_UN(sign, isd_sign) ISD_UN(exp10, __builtin_exp10f)
ISD_BIN(pow, __builtin_powf) ISD_BIN(powr, __builtin_powf) ISD_BIN(atan2, __builtin_atan2f) ISD_BIN(fmod, __builtin_fmodf)
ISD_BIN(fmin, __builtin_fminf) ISD_BIN(fmax, __builtin_fmaxf) ISD_BIN(min, __builtin_fminf) ISD_BIN(max, __builtin_fmaxf)
ISD_BIN(copysign, __builtin_copysignf)
inline int min(int a, int b) { return a < b ? a : b; }
inline int max(int a, int b) { return a > b ? a : b; }
inline uint min(uint a, uint b) { return a < b ? a : b; }
inline uint max(uint a, uint b) { return a > b ? a : b; }
inline int abs(int a) { return a < 0 ? -a : a; }
inline int clamp(int x, int a, int b) { return min(max(x, a), b); }
inline uint clamp(uint x, uint a, uint b) { return min(max(x, a), b); }

template <class T> inline T clamp(T x, T a, T b) { return min(max(x, a), b); }
inline float2 clamp(float2 x, float a, float b) { return min(max(x, a), b); }
inline float3 clamp(float3 x, float a, float b) { return min(max(x, a), b); }
inline float4 clamp(float4 x, float a, float b) { return min(max(x, a), b); }
inline float clamp(float x, float a, float b) { return min(max(x, a), b); }

inline float mix(float a, float b, float t) { return a + (b - a) * t; }
inline float2 mix(float2 a, float2 b, float t) { return a + (b - a) * t; }
inline float3 mix(float3 a, float3 b, float t) { return a + (b - a) * t; }
inline float4 mix(float4 a, float4 b, float t) { return a + (b - a) * t; }
inline float2 mix(float2 a, float2 b, float2 t) { return a + (b - a) * t; }

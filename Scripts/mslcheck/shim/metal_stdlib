// A small Metal Shading Language shim so clang can type-check the app's MSL as C++ (no Metal compiler on Linux).
// Vectors are clang ext_vector_types (swizzles .xyzw/.rgba work), address spaces are real clang address spaces
// (so passing a `constant` reference where a plain one is expected is an error, as in Metal), and the standard
// library functions are overloaded for float and float2/3/4. It errs on the side of accepting code.
#pragma once

// Address spaces are dropped: Metal lets a struct be copied out of constant memory, which clang's address
// spaces would refuse, so modelling them gave false errors.
#define device
#define constant
#define threadgroup
#define thread
#define vertex
#define fragment
#define kernel


template <bool B, class T = void> struct en_if {};
template <class T> struct en_if<true, T> { typedef T type; };

// ---- constructors (reached through the function-like macros below, so `float3 x` stays a type)
constexpr float2 mk_f2(float a) { return float2{a, a}; }
constexpr float2 mk_f2(float a, float b) { return float2{a, b}; }
template <class V, class = typename en_if<vlen<V>::n == 2>::type> constexpr float2 mk_f2(V v) { return __builtin_convertvector(v, float2); }
template <class V, class = typename en_if<(vlen<V>::n > 2)>::type, class = void> constexpr float2 mk_f2(V v) { return float2{(float)v.x, (float)v.y}; }

constexpr float3 mk_f3(float a) { return float3{a, a, a}; }
constexpr float3 mk_f3(float a, float b, float c) { return float3{a, b, c}; }
constexpr float3 mk_f3(float2 a, float b) { return float3{a.x, a.y, b}; }
constexpr float3 mk_f3(float a, float2 b) { return float3{a, b.x, b.y}; }
template <class V, class = typename en_if<vlen<V>::n == 3>::type> constexpr float3 mk_f3(V v) { return __builtin_convertvector(v, float3); }

constexpr float4 mk_f4(float a) { return float4{a, a, a, a}; }
constexpr float4 mk_f4(float a, float b, float c, float d) { return float4{a, b, c, d}; }
constexpr float4 mk_f4(float3 a, float b) { return float4{a.x, a.y, a.z, b}; }
constexpr float4 mk_f4(float a, float3 b) { return float4{a, b.x, b.y, b.z}; }
constexpr float4 mk_f4(float2 a, float2 b) { return float4{a.x, a.y, b.x, b.y}; }
constexpr float4 mk_f4(float2 a, float b, float c) { return float4{a.x, a.y, b, c}; }
constexpr float4 mk_f4(float a, float b, float2 c) { return float4{a, b, c.x, c.y}; }
constexpr float4 mk_f4(float a, float2 b, float c) { return float4{a, b.x, b.y, c}; }
template <class V, class = typename en_if<vlen<V>::n == 4>::type> constexpr float4 mk_f4(V v) { return __builtin_convertvector(v, float4); }

constexpr int2 mk_i2(int a) { return int2{a, a}; }
constexpr int2 mk_i2(int a, int b) { return int2{a, b}; }
template <class V, class = typename en_if<vlen<V>::n == 2>::type> constexpr int2 mk_i2(V v) { return __builtin_convertvector(v, int2); }
